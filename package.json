{
  "name": "hb-destockage",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "test": "npm run test --workspaces --if-present && vitest run --config scripts/vitest.config.ts && npm run test:data",
    "build": "npm run build --workspaces --if-present",
    "budget": "node tools/measure/src/budget/cli.ts",
    "lh": "node tools/measure/src/lh/cli.ts",
    "shots": "node tools/measure/src/shots/cli.ts",
    "axe": "node tools/measure/src/axe/cli.ts",
    "e2e": "node tools/measure/src/e2e/cli.ts",
    "test:data": "scripts/test-data.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/shared",
    "packages/db",
    "packages/ui-tokens",
    "packages/catalog",
    "apps/storefront",
    "apps/web",
    "apps/admin",
    "apps/jobs",
    "tools/measure"
  ]
}
