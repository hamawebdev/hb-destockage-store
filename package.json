{
  "name": "hb-destockage",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25", "npm": ">=11" },
  "workspaces": [
    "packages/shared",
    "packages/db",
    "packages/ui-tokens",
    "packages/catalog",
    "apps/storefront",
    "apps/web",
    "apps/admin",
    "apps/jobs",
    "tools/measure"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
