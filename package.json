    "e2e": "echo 'e2e: not wired yet' && exit 0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
