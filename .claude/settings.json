        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/team/on-task-completed.sh",
            "timeout": 1800
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
