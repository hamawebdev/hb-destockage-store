{
  "name": "@hb/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "check:migrations": "drizzle-kit check",
    "migrate:local": "wrangler d1 migrations apply hb-destockage --local --persist-to ../../.wrangler/hb-local",
    "seed": "node src/seed/cli.ts"
  },
  "dependencies": {
    "@hb/catalog": "*",
    "@hb/shared": "*",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/better-sqlite3": "9.6.0",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.11",
    "wrangler": "4.157.0"
  }
}
