---
/**
 * Content page (about, delivery, returns, contact, privacy, legal) from CAT-1 ContentProps.
 * Structured blocks only (h2, p, ul, ol, link): no HTML in data, everything escaped by Astro.
 * Placeholder handling (CLAUDE.md, BUG-11 class-wide): each text goes through <Copy> (marker
 * stripped, dev pill; HB_STRICT_COPY=1 refuses it), and a page marked placeholder shows the dev
 * banner (dev.placeholderBanner) in non-strict builds only. Links: same-origin paths, tel: and
 * https://wa.me/ (plain links; validated by @hb/catalog). Owner: shell.
 * Privacy page, when Meta is configured (D-014): a section from brand copy, at the top of the body, because the page's
 * own text comes from D1 and cannot change at build time. It is marked as awaiting legal review.
 */
import type { ContentBlock, ContentProps } from '@hb/catalog';
import Breadcrumbs from '../catalog/Breadcrumbs.astro';
import Copy from '../Copy.astro';
import { placeholderParts, t } from '../../lib/strings.ts';
import { metaConfig } from '../../lib/meta.mjs';

interface Props {
  props: ContentProps;
}
const { props: p } = Astro.props;
const l = p.layout;
const strict = process.env['HB_STRICT_COPY'] === '1';
const date = new Intl.DateTimeFormat(l.lang === 'ar' ? 'ar-DZ' : 'fr-DZ', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Algiers' }).format(new Date(p.page.updatedAt));
const isExternal = (href: string) => href.startsWith('https://');
const blocks: readonly ContentBlock[] = p.page.blocks;
const meta = p.page.key === 'privacy' ? metaConfig() : null;
// META_CONSENT_REQUIRED=0: no choice is asked, so the text must not promise one (Addendum 4).
const metaKeys = meta?.consent === 'off' ? 'privacy.meta.off' : 'privacy.meta';
/**
 * The Meta section's copy, with its legal-review mark as plain bracketed text (Addendum 8): the dev pill would bring
 * its own CSS, and so a style hash, onto the configured privacy page.
 */
const legal = (k: string): string =>
  placeholderParts(t(l.strings, k))
    .map((x) => ('text' in x ? x.text : `[${x.note ?? ''}]`))
    .join(' ');
// The reset button is last on the page: meta.js reveals it after load, and nothing but the footer sits below it.
// Both Meta slots sit directly against their neighbours, so with Meta off the page gains no whitespace.
---
<article class="container ct">
  <Breadcrumbs items={p.breadcrumbs} strings={l.strings} />
  {!strict && p.page.placeholder && <p class="ct-banner" role="note">{t(l.strings, 'dev.placeholderBanner')}</p>}
  <header class="ct-head">
    <h1 class="ct-title"><Copy strings={l.strings} text={p.page.title} /></h1>
    <p class="ct-date">{t(l.strings, 'content.lastUpdated', { date })}</p>
  </header>
  <div class="ct-body reading">{meta && (
      <Fragment>
        <h2>{legal('privacy.meta.title')}</h2>
        <p data-legal-review={`${metaKeys}.body1`}>{legal(`${metaKeys}.body1`)}</p>
        <p data-legal-review={`${metaKeys}.body2`}>{legal(`${metaKeys}.body2`)}</p>
        <p data-legal-review={`${metaKeys}.body3`}>{legal(`${metaKeys}.body3`)}</p>
        <p data-legal-review={`${metaKeys}.body4`}>{legal(`${metaKeys}.body4`)}</p>
      </Fragment>
    )}
    {
      blocks.map((b) => {
        switch (b.type) {
          case 'h2':
            return <h2><Copy strings={l.strings} text={b.text} /></h2>;
          case 'p':
            return <p><Copy strings={l.strings} text={b.text} /></p>;
          case 'ul':
            return <ul>{b.items.map((x) => <li><Copy strings={l.strings} text={x} /></li>)}</ul>;
          case 'ol':
            return <ol>{b.items.map((x) => <li><Copy strings={l.strings} text={x} /></li>)}</ol>;
          case 'link':
            return (
              <p class="ct-link">
                <a href={b.href} rel={isExternal(b.href) ? 'noopener' : undefined}>
                  {b.href.startsWith('tel:') || b.href.startsWith('https://wa.me/') ? <bdi dir="ltr">{b.text}</bdi> : <Copy strings={l.strings} text={b.text} />}
                </a>
              </p>
            );
        }
      })
    }{meta && <p><button type="button" class="btn btn-secondary" data-meta-reset hidden>{t(l.strings, 'consent.change')}</button></p>}
  </div>
</article>

<style is:global>
  @layer components {
    .ct { padding-block: var(--space-6) var(--section-block); }
    .ct-banner {
      margin-block: var(--space-4);
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-md);
      background: var(--color-warning-surface);
      color: var(--color-warning);
      font-size: var(--fs-small);
    }
    .ct-head { margin-block: var(--space-6) var(--space-8); }
    .ct-title { font-size: var(--fs-h1); }
    .ct-date { margin-block-start: var(--space-2); color: var(--color-text-secondary); font-size: var(--fs-small); }
    .ct-body { display: flex; flex-direction: column; gap: var(--space-4); }
    .ct-body h2 { margin-block-start: var(--space-6); font-size: var(--fs-h3); }
    .ct-body ul, .ct-body ol { display: flex; flex-direction: column; gap: var(--space-2); padding-inline-start: var(--space-6); }
    .ct-link a { display: inline-flex; align-items: center; min-block-size: var(--tap-min); min-inline-size: var(--tap-min); }
  }
</style>
