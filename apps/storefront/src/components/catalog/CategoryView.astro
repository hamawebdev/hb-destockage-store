---
/**
 * Category listing template body (inside shell's Base layout): breadcrumbs, title, description,
 * product count, sub-category chips, product grid, static pagination, empty state.
 * LCP = the first card's image (`lcp: true` from pagedata; Base preloads it).
 */
import './catalog.css';
import type { CategoryProps } from '@hb/catalog';
import Breadcrumbs from './Breadcrumbs.astro';
import Pagination from './Pagination.astro';
import ProductGrid from './ProductGrid.astro';
import SubcategoryNav from './SubcategoryNav.astro';
import { t, tp } from './lib/i18n.ts';

type Props = CategoryProps;
const { layout, category, breadcrumbs, subCategories, products, totalCount, pagination } = Astro.props;
const { lang, strings } = layout;
---
<div class="cat-page">
  <Breadcrumbs items={breadcrumbs} strings={strings} />
  <header class="cat-head">
    <h1 class="cat-title">{category.name}</h1>
    {category.placeholder && <p class="cat-ph">{t(strings, 'dev.placeholder')}</p>}
    {category.description && <p class="cat-desc">{category.description}</p>}
    <p class="cat-count">{tp(strings, lang, 'catalog.count', totalCount)}</p>
  </header>

  <SubcategoryNav current={category} totalCount={totalCount} items={subCategories} lang={lang} strings={strings} />

  {products.length > 0 ? (
    <ProductGrid cards={products} lang={lang} strings={strings} level={2} class="cat-listing" />
  ) : (
    <section class="cat-empty" aria-labelledby="cat-empty-title">
      <span class="cat-empty-icon" aria-hidden="true"></span>
      <h2 id="cat-empty-title" class="cat-empty-title">{t(strings, 'catalog.empty.title')}</h2>
      <p class="cat-empty-body">{t(strings, 'catalog.empty.body')}</p>
      <a class="cat-btn" href={layout.homeHref}>{t(strings, 'catalog.empty.cta')}</a>
    </section>
  )}

  <Pagination pagination={pagination} lang={lang} strings={strings} />
</div>

<style is:global>
  .cat-head{display:grid;gap:var(--space-2);margin-block:var(--space-6) var(--space-6)}
  @media (min-width:768px){.cat-head{margin-block:var(--space-10) var(--space-8)}}
  .cat-ph{justify-self:start;margin:0;padding:0 var(--space-2);border-radius:var(--radius-pill);background:var(--color-warning-surface);color:var(--color-warning);font-size:var(--fs-caption);line-height:1.8}
  .cat-count{margin:0;color:var(--color-text-secondary);font-size:var(--fs-small);font-variant-numeric:tabular-nums}
  .cat-desc{margin:0;max-inline-size:var(--measure);color:var(--color-text-secondary);font-size:var(--fs-lead);line-height:var(--lh-body);text-wrap:pretty}
  .cat-listing{margin-block-start:var(--space-6)}
  @media (min-width:768px){.cat-listing{margin-block-start:var(--space-10)}}
  .cat-empty{display:grid;justify-items:center;gap:var(--space-3);margin-block-start:var(--space-6);padding:var(--space-16) var(--space-6);border-radius:var(--radius-xl);background:var(--color-surface-alt);text-align:center}
  .cat-empty-icon{inline-size:48px;block-size:48px;border:1.5px solid var(--color-text-secondary);border-radius:var(--radius-md);position:relative}
  .cat-empty-icon::after{content:"";position:absolute;inset-inline:10px;inset-block-start:14px;block-size:10px;border-block-end:1.5px solid var(--color-text-secondary);border-inline:1.5px solid var(--color-text-secondary);border-end-start-radius:10px;border-end-end-radius:10px}
  .cat-empty-title{margin:var(--space-2) 0 0;font-size:var(--fs-h3);font-weight:var(--fw-emphasis);line-height:var(--lh-heading)}
  .cat-empty-body{margin:0 0 var(--space-3);max-inline-size:44ch;color:var(--color-text-secondary)}
</style>
