---
/**
 * The order step (ORDER-STEP, calm redesign CART-0): one static page per product and language, /{lang}/order/<slug>/,
 * noindex, reached from the product page's GET form or CTA link. No D1 read, no Worker render.
 *
 * Only what helps the customer finish: the title, orderform's compact line and fields, the delivery fee, the
 * total and one confirm button (Base renders the minimal chrome). The variant picker stays for the no-JS customer,
 * who confirms the variant here: its radios join the form with form="order-form"; with JS, when the product page
 * already chose (?v=), variant.js marks the root data-chosen and the picker gives way to the line.
 *
 * The root carries .cat-pdp / .cat-pdp-buy so the picker's constant CSS and variant.js work as on the product page.
 */
import './card.css';
import './catalog.css';
import type { OrderStepProps } from '@hb/catalog';
import OrderForm from '../order/OrderForm.astro';
import VariantBlocks from './VariantBlocks.astro';
import VariantPicker from './VariantPicker.astro';
import { t } from './lib/i18n.ts';
import { pickerMode } from './lib/variants.ts';

type Props = OrderStepProps;
const { layout, product, image, options, variants, orderForm } = Astro.props;
const { lang, strings } = layout;
const mode = pickerMode({ options, variants });
---
<div class="container of-page cat-pdp cat-step" data-mode={mode}>
  <div class="cat-pdp-buy">
    <h1 class="of-title">{t(strings, 'order.title')}</h1>
    <OrderForm lang={lang} form={orderForm} productName={product.name} brandLatin={product.brandLatin} strings={strings} contact={layout.contact} image={image}>
      <Fragment slot="price"><VariantBlocks options={options} variants={variants} lang={lang} strings={strings} /></Fragment>
      <Fragment slot="picker"><VariantPicker options={options} variants={variants} strings={strings} /></Fragment>
    </OrderForm>
  </div>
</div>

<style is:global>
  .cat-pdp-buy{display:grid;grid-template-columns:minmax(0,1fr);min-inline-size:0}
  .cat-step[data-chosen] .cat-picker{display:none}
</style>
