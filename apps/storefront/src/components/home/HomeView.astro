---
/**
 * Home page body (both languages). HOME-0, artifacts/HOME-0/. One idea per band, soft rounded surfaces:
 *  1. Type-led hero: one headline, one short line, one button. No photo: most photos are placeholders and the one real
 *     clean photo is a phone shot of hardware, not a hero image (artifacts/HOME-0/measure/report.md).
 *  2. Category tiles (tiles.ts): photo + name, the whole tile is the link. The first tile is the LCP.
 *  3. Products (pages' ProductGrid/ProductCard, unchanged), softened by the scoped rules below only on this page.
 *  4. One compact reassurance plus a quiet contact line (WhatsApp and phone remain plain links).
 * Owner: shell.
 */
import type { HomeProps } from '@hb/catalog';
import Icon from '../Icon.astro';
import Picture from '../Picture.astro';
import ProductGrid from '../catalog/ProductGrid.astro';
import { showDevMarkers } from '../catalog/lib/i18n.ts';
import { groupPhone, t } from '../../lib/strings.ts';
import type { Tile } from './tiles.ts';

interface Props {
  props: HomeProps;
  tiles: readonly Tile[];
}
const { props: p, tiles } = Astro.props;
const l = p.layout;
const s = (key: string) => t(l.strings, key);
const reassurance = [
  { icon: 'check', key: 'trust.cod' },
  { icon: 'truck', key: 'trust.delivery69' },
  { icon: 'phone', key: 'trust.call' },
];
const dev = showDevMarkers();
const featuredIds = new Set(p.featured.map((c) => c.id));
const morePacks = p.packs.filter((c) => !featuredIds.has(c.id));
const cards = [...p.featured, ...morePacks];
// Whole rows of cards at 2, 3 and 4 columns: a short last row reads as unfinished.
const trim2 = cards.length - (cards.length % 2);
const trim3 = cards.length >= 3 ? cards.length - (cards.length % 3) : cards.length;
const trim4 = cards.length >= 4 ? cards.length - (cards.length % 4) : cards.length;
---
<section class="hm-hero" aria-labelledby="hm-title">
  <div class="container hm-hero-in">
    <h1 id="hm-title" class="hm-title">{s('home.heroTitle')}</h1>
    <p class="hm-lead">{s('home.heroLead')}</p>
    <p class="hm-ctas"><a class="btn btn-primary" href="#hm-featured">{s('home.heroCta')}</a></p>
  </div>
</section>

{
  tiles.length > 0 && (
    <section class="container hm-cats-sec" aria-labelledby="hm-cats">
      <h2 id="hm-cats" class="hm-h2">{s('home.categoriesTitle')}</h2>
      <ul role="list" class="hm-tiles">
        {tiles.map(({ category: c, mobile, desktop, image }) => (
          <li class:list={['hm-t', `hm-t-m-${mobile}`, `hm-t-d-${desktop}`]}>
            <a class="hm-tile" href={c.href}>
              <span class="hm-tile-photo">
                <Picture image={image} />
                {dev && (c.placeholder || image.placeholder) && <span class="cat-flag cat-flag--ph hm-tile-flag">{s('dev.placeholder')}</span>}
              </span>
              <span class="hm-tile-name">{c.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  cards.length > 0 && (
    <section id="hm-featured" class="container hm-sec" aria-labelledby="hm-feat">
      <h2 id="hm-feat" class="hm-h2">{s('home.featuredTitle')}</h2>
      <div class:list={['hm-products', { 'hm-g2-odd': trim2 !== cards.length }, `hm-g3-${trim3}`, `hm-g4-${trim4}`]}>
        <ProductGrid cards={cards} lang={l.lang} strings={l.strings} level={3} addable />
      </div>
    </section>
  )
}

<section class="container hm-assure" aria-labelledby="hm-assure-t">
  <h2 id="hm-assure-t" class="visually-hidden">{s('home.howTitle')}</h2>
  <ul role="list" class="hm-assure-list">
    {
      reassurance.map((x) => (
        <li class="hm-assure-item">
          <Icon name={x.icon} class="icon-sm" />
          <span>{s(x.key)}</span>
        </li>
      ))
    }
  </ul>
  <p class="hm-contact">
    <span>{s('footer.contact')}</span>
    <a class="hm-contact-a" href={l.contact.phoneHref}><bdi dir="ltr" class="nums">{groupPhone(l.contact.phoneDisplay)}</bdi></a>
    <span aria-hidden="true">·</span>
    <a class="hm-contact-a" href={l.contact.whatsappHref}>{s('footer.whatsapp')}</a>
  </p>
</section>

<style is:global>
  @layer components {
    /* Hero: centred type, no band; compact so the tiles start in the first viewport. */
    .hm-hero-in { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); padding-block: var(--space-8) var(--space-6); text-align: center; }
    .hm-title { max-inline-size: 18ch; font-size: var(--fs-h1); line-height: var(--lh-display); letter-spacing: var(--ls-display); font-weight: var(--fw-emphasis); }
    .hm-lead { max-inline-size: 36ch; color: var(--color-text-secondary); font-size: var(--fs-body); }
    .hm-ctas { margin-block-start: var(--space-2); }
    @media (min-width: 768px) {
      .hm-hero-in { padding-block: var(--space-12) var(--space-8); }
      .hm-title { max-inline-size: 24ch; font-size: var(--fs-display); }
      .hm-lead { max-inline-size: 44ch; font-size: var(--fs-lead); }
    }

    /* Section rhythm */
    .hm-cats-sec { padding-block-start: var(--space-2); }
    .hm-sec { padding-block-start: var(--section-block); }
    .hm-h2 { font-size: var(--fs-h3); }
    .hm-sec .hm-h2 { margin-block-end: var(--space-6); }

    /* Category tiles: 2 columns on phones, 6 from 768 px; spans come from tiles.ts so every row fills. */
    .hm-tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--grid-gap); margin-block-start: var(--space-4); padding: 0; }
    .hm-t { display: grid; min-inline-size: 0; }
    .hm-t-m-full { grid-column: span 2; }
    .hm-tile {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border-radius: var(--radius-xl);
      background: var(--color-surface-alt);
      color: var(--color-text);
      text-decoration: none;
    }
    .hm-tile-photo { position: relative; display: block; overflow: hidden; background: var(--color-surface-alt); aspect-ratio: 1; }
    .hm-tile-photo img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform var(--dur-slow) var(--ease-standard); }
    .hm-t-m-full .hm-tile-photo { aspect-ratio: 16 / 9; }
    .hm-tile-flag { position: absolute; inset-block-start: var(--space-3); inset-inline-start: var(--space-3); }
    .hm-tile:hover .hm-tile-photo img { transform: scale(1.03); }
    .hm-tile:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-offset); }
    .hm-tile-name {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: center;
      padding: var(--space-4) var(--space-3);
      text-align: center;
      font-size: var(--fs-body);
      font-weight: var(--fw-emphasis);
      line-height: var(--lh-ui);
    }
    @media (min-width: 768px) {
      .hm-tiles { grid-template-columns: repeat(6, minmax(0, 1fr)); margin-block-start: var(--space-6); }
      .hm-t-d-6 { grid-column: span 6; }
      .hm-t-d-3 { grid-column: span 3; }
      .hm-t-d-2 { grid-column: span 2; }
      .hm-t-d-6 .hm-tile-photo { aspect-ratio: 21 / 9; }
      .hm-t-d-3 .hm-tile-photo { aspect-ratio: 16 / 10; }
      .hm-t-d-2 .hm-tile-photo { aspect-ratio: 1; }
      .hm-tile-name { font-size: var(--fs-lead); }
    }

    /* One compact reassurance, then a quiet contact line. */
    .hm-assure { padding-block: var(--section-block) var(--space-8); text-align: center; }
    .hm-assure-list { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2) var(--space-6); padding: 0; font-size: var(--fs-small); }
    .hm-assure-item { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-text); }
    .hm-assure-item .icon { color: var(--color-text-secondary); }
    .hm-contact { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0 var(--space-2); margin-block-start: var(--space-4); color: var(--color-text-secondary); font-size: var(--fs-small); }
    .hm-contact-a { display: inline-flex; align-items: center; min-block-size: var(--tap-min); min-inline-size: var(--tap-min); justify-content: center; color: var(--color-accent-text); }
  }
</style>

<style is:global>
  /* Products: the same soft surface as the tiles, on the home page only (ProductCard itself is untouched).
     Outside @layer on purpose: ProductCard's own rules are unlayered and would beat any layered override. */
  .hm-products .cat-grid { gap: var(--grid-gap); }
  .hm-products .cat-card { gap: 0; block-size: 100%; overflow: hidden; border-radius: var(--radius-lg); background: var(--color-surface-alt); }
  .hm-products .cat-card-media { border-radius: 0; }
  .hm-products .cat-card-body { padding: var(--space-3); }
  /* overflow: hidden above would clip the card link's outset ring: keep it inside the card. */
  .hm-products .cat-card-link:focus-visible::after { outline-offset: calc(-1 * var(--focus-width)); }
  @media (max-width: 767.98px) { .hm-g2-odd li:last-child { display: none; } }
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .hm-g3-3 li:nth-child(n + 4), .hm-g3-6 li:nth-child(n + 7), .hm-g3-9 li:nth-child(n + 10), .hm-g3-12 li:nth-child(n + 13), .hm-g3-15 li:nth-child(n + 16) { display: none; }
  }
  @media (min-width: 1024px) {
    .hm-g4-4 li:nth-child(n + 5), .hm-g4-8 li:nth-child(n + 9), .hm-g4-12 li:nth-child(n + 13), .hm-g4-16 li:nth-child(n + 17) { display: none; }
  }
</style>
