---
/**
 * A UI string from brand/copy that may still be a placeholder fact (opening hours, delays, …).
 * Dev builds: the text without its "[PLACEHOLDER]" marker, plus a visible dev pill
 * (dev.placeholder) and data-placeholder on the wrapper, so QA and screenshots show it.
 * Production (HB_STRICT_COPY=1): t() refuses the placeholder and the build fails, as on content pages.
 * Use it for every chrome string sourced from a fact the client must confirm (QA-2 BUG-11). Owner: shell.
 */
import type { StringTable } from '@hb/catalog';
import { t } from '../lib/strings.ts';

interface Props {
  strings: StringTable;
  k: string;
  class?: string;
}
const { strings, k, class: cls } = Astro.props;
const raw = t(strings, k);
const placeholder = raw.includes('[PLACEHOLDER]');
const text = raw.replace(/\s*\[PLACEHOLDER\]\s*/g, ' ').trim();
---
<span class={cls} data-placeholder={placeholder ? k : undefined}>{text}{placeholder && <> <span class="dev-ph">{t(strings, 'dev.placeholder')}</span></>}</span>

<style is:global>
  @layer components {
    .dev-ph {
      display: inline-block;
      padding-inline: var(--space-2);
      border-radius: var(--radius-pill);
      background: var(--color-warning-surface);
      color: var(--color-warning);
      font-size: var(--fs-caption);
      font-weight: var(--fw-emphasis);
      white-space: nowrap;
    }
  }
</style>
