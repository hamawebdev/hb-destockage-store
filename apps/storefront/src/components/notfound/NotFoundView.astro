---
/**
 * 404 body (per language; served by Workers static assets `404-page` from /ar/404.html,
 * /fr/404.html and the root /404.html). Title, short explanation, two ways back (home, search),
 * and the top-level categories. Never indexed (layout.noindex). Owner: shell.
 */
import type { NotFoundProps } from '@hb/catalog';
import Icon from '../Icon.astro';
import { t } from '../../lib/strings.ts';

interface Props {
  props: NotFoundProps;
}
const { props: p } = Astro.props;
const l = p.layout;
const s = (key: string) => t(l.strings, key);
---
<section class="container nf" aria-labelledby="nf-title">
  <p class="nf-code nums" aria-hidden="true">404</p>
  <h1 id="nf-title" class="nf-title">{s('notFound.title')}</h1>
  <p class="nf-body">{s('notFound.body')}</p>
  <p class="nf-ctas">
    <a class="btn btn-primary" href={l.homeHref}>{s('notFound.homeCta')}</a>
    <a class="btn btn-secondary" href={l.searchHref}><Icon name="search" />{s('notFound.searchCta')}</a>
  </p>
  {
    p.categories.length > 0 && (
      <nav class="nf-cats" aria-label={s('chrome.categories')}>
        <ul role="list">
          {p.categories.map((c) => (
            <li><a href={c.href}>{c.name}</a></li>
          ))}
        </ul>
      </nav>
    )
  }
</section>

<style is:global>
  @layer components {
    .nf { display: flex; flex-direction: column; align-items: center; gap: var(--space-4); padding-block: var(--space-16) var(--section-block); text-align: center; }
    .nf-code { font-size: var(--fs-hero); font-weight: var(--fw-emphasis); line-height: 1; color: var(--color-text-secondary); }
    .nf-title { font-size: var(--fs-h1); }
    .nf-body { max-inline-size: 40ch; color: var(--color-text-secondary); }
    .nf-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-block-start: var(--space-2); }
    .nf-cats { margin-block-start: var(--space-8); }
    .nf-cats ul { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); padding: 0; }
    .nf-cats a {
      display: inline-flex;
      align-items: center;
      min-block-size: var(--tap-min);
      min-inline-size: var(--tap-min);
      padding-inline: var(--space-4);
      border-radius: var(--radius-pill);
      background: var(--color-surface-alt);
      color: var(--color-text);
      text-decoration: none;
    }
    .nf-cats a:hover { background: var(--color-accent-surface); }
  }
</style>
