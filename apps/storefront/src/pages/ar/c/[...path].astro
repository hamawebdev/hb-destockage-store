---
// Category listing (ar). Owner: pages. Template body: src/components/catalog/CategoryView.astro.
import Base from '../../../layouts/Base.astro';
import CategoryView from '../../../components/catalog/CategoryView.astro';
import { staticPaths, type PropsByTemplate } from '../../../lib/catalog.ts';

export const getStaticPaths = () => staticPaths('category', 'ar');
const props = Astro.props as PropsByTemplate['category'];
---
<Base layout={props.layout} lcp={props.products.some((c) => c.image?.lcp)}>
  <CategoryView {...props} />
</Base>
