---
// Product page with order form (ar). SHELL-1 stub, owned by `pages` from here on (order form: `orderform`, src/components/order/).
import Base from '../../../layouts/Base.astro';
import { staticPaths, type PropsByTemplate } from '../../../lib/catalog.ts';
