// Admin Worker (admin.<domain>, behind Cloudflare Access). Owner: admin-core.
// ENV defaults to "production" (fail-safe): only `npm run dev` passes --var ENV:development.
// Secrets (never in this file): CSRF_SECRET; DEV_SESSION_SECRET (development only);
// SETTINGS_ENCRYPTION_KEY (seals the Meta access token, D-017; the pipeline uploads it, see docs/META-GO-LIVE.md).
// Locally they come from apps/admin/.dev.vars (gitignored; see .dev.vars.example).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Close every non-Access entry point: Access protects the custom domain only.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENV": "production",
    "ACCESS_TEAM_DOMAIN": "https://delicate-band-95d7.cloudflareaccess.com",
    "ACCESS_AUD": "a503a97b7a91ca1bc9a03e4f44ec7163d28bcb510951815d1db0157f211cc74a"
  },
  // Shared local D1 convention: packages/db/wrangler.jsonc.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hb-destockage",
      "database_id": "caa72d86-5488-425a-8031-3d3fbc47a248",
      "preview_database_id": "00000000-0000-4000-8000-000000000d1b",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "hb-media" }],
  // Every request, including static files, goes through the Worker (auth + headers).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
  "dev": { "port": 4240, "ip": "127.0.0.1" },
  "routes": [{ "pattern": "admin.comptoirdeluxe.com", "custom_domain": true }]
}
