// HB Destockage storefront Worker (owner: web). Plan: artifacts/WEB-0/plan.md §1.1.
// Static assets (the Astro build) are served before the Worker runs; the Worker only sees the
// `run_worker_first` paths: /api/* and the order confirmation page (ref filled in, no D1).
// Local only: `npm run dev -w @hb/web` (port 4210, inspector 4211). No login, no deploy.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../storefront/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/ar/order/confirmation/*", "/fr/order/confirmation/*"]
  },
  // One D1 database. Production: `wrangler d1 create hb-destockage --location weur` (see ops/); never created from here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hb-destockage",
      "database_id": "00000000-0000-4000-8000-000000000d1b",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // order.created → apps/jobs (consumer + DLQ hb-order-notifications-dlq are declared there).
  "queues": { "producers": [{ "binding": "ORDERS", "queue": "hb-order-notifications" }] },
  // Workers Rate Limiting binding: period must be 10 or 60 s. Phone = primary key (429);
  // IP = secondary key (flag only, never reject: CGNAT).
  "ratelimits": [
    { "name": "ORDER_RL_PHONE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "ORDER_RL_IP", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  // Secrets (never here): TURNSTILE_SECRET, ORDER_SIGNING_KEY, IP_HASH_KEY — `.dev.vars` locally.
  "vars": {
    "ENV": "development",
    "SITE_HOSTS": "localhost,127.0.0.1",
    "MIN_FILL_MS": "2500",
    "MIN_REVIEW_MS": "1500",
    "RUM_SAMPLE": "1"
  },
  "minify": true,
  "observability": { "enabled": true },
  "dev": { "port": 4210, "inspector_port": 4211 },
  "env": {
    // Test environment: same bindings (bindings are not inherited by named envs), a fixture
    // asset directory so tests do not depend on the storefront build.
    "test": {
      "assets": {
        "directory": "./test/fixtures/assets",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        "run_worker_first": ["/api/*", "/ar/order/confirmation/*", "/fr/order/confirmation/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hb-destockage",
          "database_id": "00000000-0000-4000-8000-000000000d1b",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "queues": { "producers": [{ "binding": "ORDERS", "queue": "hb-order-notifications" }] },
      "ratelimits": [
        { "name": "ORDER_RL_PHONE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
        { "name": "ORDER_RL_IP", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
      ],
      "vars": {
        "ENV": "test",
        "SITE_HOSTS": "localhost,127.0.0.1,example.com",
        "MIN_FILL_MS": "2500",
        "MIN_REVIEW_MS": "1500",
        "RUM_SAMPLE": "1"
      }
    }
  }
}
