{
  "name": "@hb/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build": "(test -d ../storefront/dist || npm --prefix ../.. run build -w @hb/storefront) && wrangler deploy --dry-run --env=\"\" --outdir dist",
    "dev": "wrangler dev --env=\"\" --port ${PORT:-4210} --inspector-port ${INSPECTOR_PORT:-4211} --ip 127.0.0.1 --var ENV:development --var SITE_HOSTS:localhost,127.0.0.1 --persist-to ../../.wrangler/hb-local"
  },
  "dependencies": {
    "@hb/db": "*",
    "@hb/shared": "*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "wrangler": "4.157.0"
  }
}
