# Local only. Courier and Google HTTP is held to loopback unless ENV is exactly "production".
ENV=development

# Courier sync (SHIP-5) and Sheets sync: the same COURIER_KEYS_KEY as apps/admin (local placeholder).
COURIER_KEYS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# COURIER_STANDIN_URL=http://127.0.0.1:4410

# Google Sheets against the local stand-in (node tools/standins/sheets/server.mjs --port 4420).
GOOGLE_CLIENT_ID=standin-client
GOOGLE_CLIENT_SECRET=standin-secret
GOOGLE_STANDIN_URL=http://127.0.0.1:4420

# Telegram (TGS): the bot token and the chats are set in the admin, never here. Outside production
# Telegram is off unless this points at a loopback stand-in
# (node tools/standins/telegram/server.mjs --port 4430) or at the local live proxy
# (node tools/standins/live-proxy.mjs --port 4430, local acceptance only).
# TELEGRAM_STANDIN_URL=http://127.0.0.1:4430
