// hb-jobs: scheduled jobs + order-notification Queue consumer. Owner: jobs.
// Local only (no deploy from this project): `npx wrangler dev --test-scheduled` (port 4120).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // 02:00 UTC = 03:00 Algiers: daily backup (JOBS-1).
  "triggers": { "crons": ["0 2 * * *"] },
  "d1_databases": [
    // Shared D1, repo convention (packages/db/wrangler.jsonc): local placeholder id, local state
    // under ../../.wrangler/hb-local (`--persist-to`). The client sets the real id at deploy.
    {
      "binding": "DB",
      "database_name": "hb-destockage",
      "database_id": "00000000-0000-4000-8000-000000000d1b",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "hb-order-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // Per-message retries use explicit exponential backoff (src/notify/consumer.ts);
        // after this many attempts Cloudflare moves the message to the DLQ.
        "max_retries": 10,
        "dead_letter_queue": "hb-order-notifications-dlq"
      }
    ],
    "producers": [
      // Permanent failures and malformed messages are forwarded here explicitly.
      { "binding": "ORDER_NOTIFICATIONS_DLQ", "queue": "hb-order-notifications-dlq" }
    ]
  },
  // Email notifications are off unless NOTIFY_EMAIL_FROM and NOTIFY_EMAIL_TO are also set
  // (vars/secrets). Destination must be verified in Email Routing.
  "send_email": [{ "name": "NOTIFY_EMAIL" }],
  // TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID: `wrangler secret put` (or .dev.vars locally). Unset = disabled.
  "observability": { "enabled": true },
  "dev": { "port": 4120 }
}
